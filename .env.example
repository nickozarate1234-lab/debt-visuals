# Copy to .env.local for local development, and set the same values in
# Vercel → Project → Settings → Environment Variables. Never commit real secrets.

# Supabase (Project Settings → API)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable/anon key>
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable/anon key>
# Server only — used by the iPhone Shortcut endpoint. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# Gemini (Google AI Studio → Get API key). Server only.
GEMINI_API_KEY=<key>
# Optional: models for voice and voucher parsing, tried in order (default below).
# GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Show "Continuar con Google" once the Google provider is enabled in Supabase Auth.
# VITE_GOOGLE_AUTH=true
